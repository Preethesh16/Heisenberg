PORT=3001
USE_FIXTURES=true

# Venue keys — fill in locally, then set USE_FIXTURES=false. Never committed.
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
MAYA_API_KEY=

# Chintu's Maya voice. Only Ananya or Arjun exist, case-sensitive.
MAYA_VOICE=Arjun

# Provider defaults — verified live against docs.mayaresearch.ai on event day.
# MAYA_TTS_URL=https://tts.mayaresearch.ai/v1/tts
# MAYA_MODEL=Maya 2 Native Emotional
# SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text

# Sarvam model: saarika:v2.5 is the live-verified demo default. Sarvam docs mark
# it legacy — saaras:v3 (+ mode) is supported behind config; live-test before
# switching, and switch back here if v3 regresses.
# SARVAM_STT_MODEL=saarika:v2.5
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_STT_MODE=transcribe   # or codemix for Hinglish — test against the UI first

# Provider deadlines (ms). Stalled providers abort into the quiet fallbacks.
# SARVAM_TIMEOUT_MS=15000
# MAYA_TIMEOUT_MS=30000

# Comma-separated allowed browser origins (Vite-proxied requests skip CORS).
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Idle sessions are dropped after this many minutes (in-memory store).
# SESSION_TTL_MINUTES=60
